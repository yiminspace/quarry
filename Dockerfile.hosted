# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM rust:1.89-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/qy/ apps/qy/
COPY apps/server/ apps/server/
COPY --from=web /src/src/quarry/web_dist/ src/quarry/web_dist/
RUN cargo build --locked --release -p quarry-server

FROM ubuntu:24.04 AS runtime
ARG GIT_SHA=dev
ENV GIT_SHA=${GIT_SHA} QUARRY_HOSTED_CONFIG=/etc/quarry/hosted.json
LABEL org.opencontainers.image.source="https://github.com/yiminspace/quarry"
LABEL org.opencontainers.image.revision=${GIT_SHA}
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 quarry && useradd --uid 10001 --gid 10001 --no-create-home quarry \
    && mkdir -p /var/lib/quarry/cloud-local && chown -R quarry:quarry /var/lib/quarry
COPY --from=build /src/target/release/quarry-server /usr/local/bin/quarry-server
# Docker CLI only (no daemon): optional cloud Local talks to a separate Docker-in-Docker service.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD ["quarry-server", "healthcheck"]
ENTRYPOINT ["quarry-server"]
